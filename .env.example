# Copiá este archivo a .env y completá tu API key.
# Proveedor por defecto: gemini (capa gratuita de Google AI Studio).
LLM_PROVIDER=gemini

# Se obtiene gratis en https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcional: si la capa gratuita de tu key se queda sin cuota (429), podés
# agregar keys adicionales (de otros proyectos de AI Studio) y el sistema
# rota automáticamente a la siguiente cuando la actual se agota. No hace
# falta usar esto si con una sola key te alcanza.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Alternativas (solo si cambiás LLM_PROVIDER a openai / anthropic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Opcional: habilita una tool real de búsqueda web en el Agente de Investigación
TAVILY_API_KEY=

# Salvaguardas del Supervisor contra el "Supervisor Infinito"
MAX_STEPS=6
MAX_REFINEMENTS=1
